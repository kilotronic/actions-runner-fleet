.DS_Store
*.swp
*.swo
__pycache__/
*.pyc
.venv/
# Local artifact: running `uv`/`uvx` in this repo writes one, but nothing here
# consumes it — CI builds its venv with `python3 -m venv` + pip, and ruff
# runs from the shared lint hooks. Committing it would just be churn from whoever last ran uv.
uv.lock
.pytest_cache/
.ruff_cache/
.serena/

# Secrets: never commit local environment files
.env
.env.*
!.env.example
